# ============================================================
# ChefPal Server 环境变量示例
# 复制为 .env 并填写真实值。.env 已被 git 忽略，切勿提交。
# ============================================================

# ---- 应用 ----
APP_ENV=dev                     # dev / test / prod
DEBUG=true

# ---- 数据库（本地 docker compose 默认；生产填真实主机/密码）----
DATABASE_URL=postgresql+asyncpg://chefpal:chefpal_dev_password@localhost:5432/chefpal
TEST_DATABASE_URL=postgresql+asyncpg://chefpal:chefpal_dev_password@localhost:5432/chefpal_test

# ---- 安全 ----
# 生产必须替换为强随机密钥，例如: openssl rand -hex 32
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=10080         # 7 天（毫秒内可静默刷新）

# ---- 微信小程序（必填）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ---- 阿里云百炼 DeepSeek（必填）----
# 请在百炼控制台核对真实模型 ID
# deepseek-v4-flash-0731 = 有 100 万免费额度的版本（推荐 MVP 使用）；deepseek-v4-flash 为常规版本
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4-flash-0731
DEEPSEEK_MODEL_PRO=deepseek-v4-flash
AI_ENABLE_SEARCH=true            # 开启联网搜索（首页问答 P0 必需）
AI_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=1                 # 结构化校验失败重试次数

# ---- 智谱 GLM 视觉（拍照识食材，免费模型）----
# 与百炼独立；未配置时视觉识别接口返回清晰错误，不影响其他功能
# 注册/取 key：https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4v-flash   # 免费快速识别；可换 glm-4.1v-thinking-flash（思考更强）

# ---- 风控 ----
DAILY_AI_LIMIT=20                # 单用户每日 AI 调用上限

# ---- CORS（本地开发放开，生产收紧）----
CORS_ORIGINS=["*"]

# ---- 腾讯云 COS（社区作品图片存储；未配置则自动回落本地磁盘，开发/测试可用）----
# 存储桶建议开启公有读（或走 CDN/自定义域名），小程序端通过公网 URL 展示图片
# 填写后重启后端即生效，无需其他改动
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou          # 存储桶所在地域，如 ap-guangzhou / ap-shanghai
COS_BUCKET=                      # 存储桶名，如 chefpal-1250000000（含 APPID 后缀）
